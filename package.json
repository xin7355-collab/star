{
  "name": "star",
  "private": true,
  "type": "module",
  "description": "星座手帳：手機優先、離線計算的星座網頁 App",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "npm run build:vendor && npm run build:worker",
    "test:e2e": "playwright test --trace off"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "astronomy-engine": "2.1.19",
    "esbuild": "0.28.2",
    "iztro": "2.6.5",
    "lunar-typescript": "1.8.6"
  },
  "overrides": {
    "i18next": "26.7.2"
  }
}
